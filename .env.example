# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Для docker compose
# Длинная случайная строка, например: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Moscow
# Публичный HTTPS-адрес n8n для вебхука Телеграма, например https://n8n.example.ru/
WEBHOOK_URL=

# Для настройки конвейеров. В контейнер не передаются: доступ узлов к
# переменным окружения в n8n закрыт, и так безопаснее. Ключи вводятся в
# учётные данные n8n, остальное в узел «Настройки» конвейера (docs/setup.md).

# Нейросеть через совместимый с OpenAI интерфейс (по умолчанию Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=

# Телеграм
TELEGRAM_BOT_TOKEN=
# Канал для публикации: @имя_канала или числовой номер вида -100...
TELEGRAM_CHANNEL_ID=
# Чат редактора: только из него бот принимает нажатия кнопок
EDITOR_CHAT_ID=

# Журнал SQLite внутри тома n8n
CF_DB_PATH=/home/node/.n8n/content-factory.sqlite
